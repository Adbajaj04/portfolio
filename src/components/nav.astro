---
const navItems = [
  {
    name: "Home",
    href: "#home",
    group: 1,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10 9-7 9 7"/><path d="M5 9v11h14V9"/><path d="M9 20v-7h6v7"/></svg>`,
  },
  {
    name: "Projects",
    href: "#projects",
    group: 1,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>`,
  },
  {
    name: "Education",
    href: "#education",
    group: 2,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m2 10 10-5 10 5-10 5-10-5Z"/><path d="M6 12v5c3.5 3 8.5 3 12 0v-5"/><path d="M22 10v6"/></svg>`,
  },
  {
    name: "Experience",
    href: "#experience",
    group: 2,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V4h8v3"/><path d="M3 12h18"/><path d="M10 12v2h4v-2"/></svg>`,
  },
  {
    name: "Skills",
    href: "#skills",
    group: 2,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9z"/></svg>`,
  },
  {
    name: "About",
    href: "/about",
    group: 3,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg>`,
  },
  {
    name: "Resume",
    href: "/resume",
    group: 3,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h8"/></svg>`,
  },
];
---

<nav
  id="main-nav"
  class="fixed top-5 left-1/2 z-50 w-max max-w-[95vw] -translate-x-1/2"
  aria-label="Main navigation"
>
  <div
    class="nav-container flex items-center justify-center gap-1 rounded-full border border-white/10 px-2 py-2 shadow-lg backdrop-blur-xl sm:gap-2"
  >
    {navItems.map((item, index) => (
      <>
        {index > 0 && item.group !== navItems[index - 1].group && (
          <span class="nav-separator" aria-hidden="true"></span>
        )}

        <a
          href={item.href}
          class="nav-link relative flex items-center gap-2 rounded-full px-3 py-2 text-sm transition-colors duration-200 sm:px-4"
          data-nav-link
        >
          <span class="nav-indicator" aria-hidden="true"></span>
          <span class="nav-icon" set:html={item.icon}></span>
          <span>{item.name}</span>
        </a>
      </>
    ))}
  </div>
</nav>

<style>
  .nav-container {
    background: var(--component-bg, rgba(20, 20, 20, 0.85));
    border-color: rgba(255, 255, 255, 0.12);
  }

  .nav-link {
    color: rgba(255, 255, 255, 0.65);
    white-space: nowrap;
    text-decoration: none;
  }

  .nav-link:hover {
    color: rgba(255, 255, 255, 0.95);
  }

  .nav-link.active {
    color: #fff;
  }

  .nav-separator {
    display: block;
    flex-shrink: 0;
    width: 1px;
    height: 24px;
    margin: 0 5px;
    background: rgba(255, 255, 255, 0.3);
  }

  .nav-indicator {
    position: absolute;
    left: 5px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #a9ff5b;
    opacity: 0;
    transform: translateY(-50%) scale(0);
    transition: transform 200ms ease, opacity 200ms ease;
    pointer-events: none;
  }

  .nav-link.active .nav-indicator {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }

  .nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .nav-icon :global(svg) {
    display: block;
    width: 16px;
    height: 16px;
  }

  @media (max-width: 640px) {
    .nav-link {
      gap: 5px;
      padding-left: 8px;
      padding-right: 8px;
      font-size: 12px;
    }

    .nav-separator {
      height: 20px;
      margin: 0 2px;
    }

    .nav-indicator {
      left: 3px;
      width: 5px;
      height: 5px;
    }
  }
</style>

<script>
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(
      "#main-nav [data-nav-link]"
    )
  );

  const sections = navLinks
    .map((link) => {
      const href = link.getAttribute("href");

      // Only section anchors belong to the scroll-tracking system.
      if (!href?.startsWith("#")) return null;

      const id = href.slice(1);
      const section = id ? document.getElementById(id) : null;

      return section ? { link, section } : null;
    })
    .filter(
      (item): item is {
        link: HTMLAnchorElement;
        section: HTMLElement;
      } => item !== null
    );

  function setActiveLink(id: string) {
    navLinks.forEach((link) => {
      const isActive = link.getAttribute("href") === `#${id}`;

      link.classList.toggle("active", isActive);

      if (isActive) {
        link.setAttribute("aria-current", "location");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  }

  // Make the clicked section active immediately and scroll smoothly.
  navLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      const href = link.getAttribute("href");

      // Allow normal navigation for About and Resume.
      if (!href?.startsWith("#")) return;

      const target = document.querySelector<HTMLElement>(href);
      if (!target) return;

      event.preventDefault();
      setActiveLink(href.slice(1));

      target.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });

      history.replaceState(null, "", href);
    });
  });

  // Track the section currently nearest the top of the viewport.
  let ticking = false;

  function updateActiveSection() {
    ticking = false;

    if (!sections.length) return;

    const marker = window.innerHeight * 0.35;
    let current = sections[0];

    for (const item of sections) {
      const rect = item.section.getBoundingClientRect();

      if (rect.top <= marker) {
        current = item;
      } else {
        break;
      }
    }

    setActiveLink(current.section.id);
  }

  function requestActiveUpdate() {
    if (ticking) return;

    ticking = true;
    window.requestAnimationFrame(updateActiveSection);
  }

  window.addEventListener("scroll", requestActiveUpdate, {
    passive: true,
  });

  window.addEventListener("resize", requestActiveUpdate);

  // Set the correct active item on initial page load.
  const initialId = window.location.hash.slice(1);
  const initialSection = sections.find(
    (item) => item.section.id === initialId
  );

  if (initialSection) {
    setActiveLink(initialId);
  } else {
    updateActiveSection();
  }
</script>