---


<section
  id="experience"
  class="scroll-mt-24 border-t border-white/10 py-24 text-[#dfdfdf] sm:py-32"
>
  <div class="mb-12">
    <p class="mb-3 text-sm font-medium uppercase tracking-[0.25em] text-[#a476ff]">
      Technical Background
    </p>

    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
      Experience<span class="text-[#a476ff]">.</span>
    </h2>

    <p class="mt-4 max-w-xl leading-7 text-[#dfdfdf]/60">
      My technical experience, group collaboration, and hands-on work.
    </p>
  </div>

  <div class="space-y-10">
    {experiences.map((item) => (
      <article class="relative border-l border-[#a476ff]/40 pl-6 sm:pl-8">
        <span class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full bg-[#a476ff]" />

        <p class="text-sm text-[#a476ff]">{item.dates}</p>

        <h3 class="mt-2 text-xl font-semibold">
          {item.subject}
        </h3>

        <p class="mt-1 text-[#dfdfdf]/70">
          {item.role}
        </p>

        <p class="mt-4 text-sm leading-7 text-[#dfdfdf]/60">
          {item.description}
        </p>

        {item.achievements && item.achievements.length > 0 && (
          <ul class="mt-4 space-y-3">
            {item.achievements.map((achievement) => (
              <li class="flex gap-3 text-sm leading-6 text-[#dfdfdf]/70">
                <span class="text-[#a476ff]">↳</span>
                <span>{achievement}</span>
              </li>
            ))}
          </ul>
        )}

        {item.technologies && item.technologies.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {item.technologies.map((technology) => (
              <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs text-[#dfdfdf]/70 transition hover:border-[#a476ff]/50 hover:text-white">
                {technology}
              </span>
            ))}
          </div>
        )}
      </article>
    ))}
  </div>
</section>
	