---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: {
      slug: project.id.replace(/\.md$/, ""),
    },
    props: {
      project,
    },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={project.data.title}>
  <main class="min-h-screen bg-background px-[5%] pb-20 pt-28 text-white">
    <article class="mx-auto max-w-[800px]">
      <!-- Back to Projects -->
      <a
        href="/#projects"
        class="mb-6 inline-flex items-center gap-2 text-sec no-underline transition-opacity hover:opacity-75"
      >
        <span aria-hidden="true">&larr;</span>
        Back to projects
      </a>

      <!-- Project Header -->
      <header class="mb-8">
        <h1 class="mb-4 text-4xl font-bold leading-tight sm:text-5xl">
          {project.data.title}
        </h1>

        <p class="leading-relaxed text-neutral-400">
          {project.data.description}
        </p>

        {project.data.date && (
          <time
            datetime={project.data.date.toISOString()}
            class="mt-4 block text-sm text-neutral-500"
          >
            {project.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        )}
      </header>

      <!-- Smaller Cover Image -->
      {project.data.cover && (
        <figure class="my-8">
          <img
            src={project.data.cover.image}
            alt={project.data.cover.alt}
            class="project-cover mx-auto block h-auto w-full max-w-[560px] rounded-2xl"
          />

          {project.data.cover.caption && (
            <figcaption class="mx-auto mt-3 max-w-[560px] text-sm text-neutral-400">
              {project.data.cover.caption}
            </figcaption>
          )}
        </figure>
      )}

      <!-- Project Tags -->
      {project.data.tags.length > 0 && (
        <ul class="my-6 flex flex-wrap gap-2">
          {project.data.tags.map((tag: string) => (
  <li class="rounded-full border border-white/15 px-3 py-1 text-sm text-neutral-300">
    {tag}
  </li>
))}
        </ul>
      )}

      <!-- Markdown Content -->
      <article class="markdown-content mt-10 leading-relaxed">
        <Content />
      </article>

      <!-- Bottom Navigation -->
      <footer class="mt-16 border-t border-white/10 pt-6">
        <a
          href="/#projects"
          class="inline-flex items-center gap-2 text-sec no-underline transition-opacity hover:opacity-75"
        >
          <span aria-hidden="true">&larr;</span>
          Back to all projects
        </a>
      </footer>
    </article>
  </main>

  <style>
    .markdown-content :global(img) {
      display: block;
      width: 100%;
      max-width: 560px;
      height: auto;
      margin: 24px auto;
      border-radius: 12px;
    }

    .markdown-content :global(p) {
      margin: 16px 0;
      color: #d4d4d4;
    }

    .markdown-content :global(h2) {
      margin-top: 40px;
      margin-bottom: 16px;
      color: #fff;
      font-size: 1.6rem;
      font-weight: 700;
    }

    .markdown-content :global(ul) {
      margin: 16px 0;
      padding-left: 24px;
      list-style: disc;
    }

    .markdown-content :global(li) {
      margin: 8px 0;
      color: #d4d4d4;
    }

    .markdown-content :global(strong) {
      color: #fff;
    }
  </style>
</Layout>