
---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Resume | Aditya Bajaj">
  <main class="min-h-screen bg-background px-[5%] pb-20 pt-28 text-white">
    <div class="mx-auto max-w-4xl">
      <!-- Header -->
      <div class="mb-8">
        <a
          href="/#home"
          class="mb-6 inline-flex items-center gap-2 text-[var(--sec)] no-underline transition-opacity hover:opacity-75"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6" />
          </svg>
          Back to portfolio
        </a>

        <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">
          My Resume
        </h1>

        <p class="mt-3 text-[var(--white-icon)]">
          View my resume or download a copy below.
        </p>
      </div>

      <!-- Download button -->
      <div class="mb-8">
        <a
          href="/resume.pdf"
          download="Aditya-Bajaj-Resume.pdf"
          class="inline-flex items-center gap-2 rounded-lg bg-[var(--sec)] px-5 py-3 font-medium text-black no-underline transition-opacity hover:opacity-80"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          Download Resume
        </a>
      </div>

      <!-- PDF preview -->
      <div class="overflow-hidden rounded-2xl border border-white/10 bg-[#141414]">
        <iframe
          src="/resume.pdf"
          title="Aditya Bajaj Resume"
          class="block h-[75vh] min-h-[600px] w-full"
        ></iframe>
      </div>

      <!-- Fallback link -->
      <p class="mt-4 text-sm text-neutral-400">
        If the preview doesn't load, you can <a href="/resume.pdf"  target="_blank" rel="noopener noreferrer" class="text-[var(--sec)] underline underline-offset-4 transition hover:opacity-80" >open the resume directly</a>.
      </p>
    </div>
  </main>
</Layout>
